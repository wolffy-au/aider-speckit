{
    "name": "AiderDevContainer",
    "image": "mcr.microsoft.com/devcontainers/python:3.12-trixie",
    "runArgs": ["--network=sonar-net"],
    "features": {
        "ghcr.io/devcontainers/features/common-utils:2": {
            "installZsh": true,
            "installOhMyZsh": true,
            "installOhMyZshConfig": true,
            "upgradePackages": true,
            "username": "devcontainer"
        },
        "ghcr.io/devcontainers/features/git:1": {
            "ppa": true,
            "version": "latest"
        },
        "ghcr.io/devcontainers/features/python:1": {
            "version": "3.12",
            "installTools": true,
            "toolsToInstall": "flake8,autopep8,black,yapf,mypy,pydocstyle,pycodestyle,bandit,pipenv,virtualenv,pytest,pylint"
        },
        "ghcr.io/devcontainers/features/node": {
            "version": "lts"
        }
    },
    // Use 'forwardPorts' to make a list of ports inside the container available locally.
    "forwardPorts": [],
    "containerUser": "devcontainer",
    "updateRemoteUserUID": true,
    "remoteUser": "root",
    "postCreateCommand": "chown -R ${containerUser}:${containerUser} ${containerWorkspaceFolder} && chmod +x ./.devcontainer/post-create.sh && ./.devcontainer/post-create.sh || true",
    "postStartCommand": "git config --global --add safe.directory ${containerWorkspaceFolder}",
    "customizations": {
        "vscode": {
            "extensions": [
                "lee2py.aider-composer",
                "mhutchie.git-graph",
                "charliermarsh.ruff",
                "ms-python.vscode-mypy",
                "ms-python.vscode-pyright",
                "ms-python.vscode-pylance",
                "ms-python.autopep8",
                "ms-python.debugpy"
            ],
            "settings": {
                "debug.javascript.autoAttachFilter": "disabled", // fix running commands in integrated terminal
                // Specify settings for Github Copilot
                "git.autofetch": true,
                "chat.promptFilesRecommendations": {
                    "speckit.constitution": true,
                    "speckit.specify": true,
                    "speckit.plan": true,
                    "speckit.tasks": true,
                    "speckit.implement": true,
                    "speckit.analyze": true,
                    "speckit.checklist": true,
                    "speckit.clarify": true,
                    "speckit.taskstoissues": true
                },
                "chat.tools.terminal.autoApprove": {
                    ".specify/scripts/bash/": true,
                    ".specify/scripts/powershell/": false
                }
            }
        }
    }
}